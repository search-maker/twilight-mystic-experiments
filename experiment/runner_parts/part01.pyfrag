ROOT = Path(__file__).resolve().parents[1]
EXP = ROOT / "experiment"
RUNNER_PART_DIR = EXP / "runner_parts"
RUNNER_PART_PATHS = [RUNNER_PART_DIR / f"part{index:02d}.pyfrag" for index in range(1, 7)]


def runner_bundle_hash() -> str:
    digest = hashlib.sha256()
    for path in [Path(__file__).resolve(), *RUNNER_PART_PATHS]:
        payload = path.read_bytes()
        digest.update(len(payload).to_bytes(8, "big"))
        digest.update(payload)
    return digest.hexdigest()
MANIFEST_PATH = EXP / "manifest.json"
CONTRACT_PATH = EXP / "contract.json"
BASELINE_PATH = EXP / "baseline.json"
GRID_PATH = EXP / "wavelength-grid.dat"
