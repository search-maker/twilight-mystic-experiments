AUDIT_PATH = EXP / "audit.py"
EXECUTION_WORKFLOW_PATH = ROOT / ".github/workflows/execution.yml"
STAGE_ID = "corrected-weak-twilight-alis-spectral-convergence-v1"
RUNNER_ID = "corrected-spectral-convergence-runner-v1"
AUTH_BRANCH = "authorization/corrected-spectral-convergence-v1"
SELECTED_NODES = [470, 480, 490, 500, 510, 520, 530, 540, 560, 580, 590, 600, 610, 640, 660]
CIE_V = [0.09098, 0.13902, 0.20802, 0.323, 0.503, 0.71, 0.862, 0.954, 0.995, 0.87, 0.757, 0.631, 0.503, 0.175, 0.061]
WAVELENGTH_RANGE = [380, 780]
