    types: [opened]
    paths:
      - experiments/aerosol-family-challenge-v2-r8/authorization.json
permissions:
  contents: read
  actions: read
  issues: read
  pull-requests: read
jobs:
  authorization-review:
    if: ${{ false }}
    runs-on: ubuntu-24.04
    steps:
      - run: |
          echo "review-only template; publication review required before activation"
          exit 2
