# REVIEW-ONLY execution transport template. Not installed under .github/workflows.
# A future reviewed version must bind its own raw SHA in the one-purpose authorization.
name: aerosol-family-v2-execution-candidate
on:
  push:
    branches:
      - dispatch/aerosol-family-challenge-v2-ordinal-PLACEHOLDER
jobs:
  preflight:
    runs-on: ubuntu-24.04
    outputs:
      matrix2: ${{ steps.matrix.outputs.matrix2 }}
      matrix4: ${{ steps.matrix.outputs.matrix4 }}
      matrix6: ${{ steps.matrix.outputs.matrix6 }}
      matrix8: ${{ steps.matrix.outputs.matrix8 }}
    steps:
      - uses: actions/checkout@v4
        with: {fetch-depth: 0}
      - id: matrix
        shell: bash
        run: |
          set -euo pipefail
          # Future reviewed preflight must re-run exact-head tracked-tree + repository-global
          # seed and identity freshness, validate the externally-bound authorization HEAD,
          # successful zero-runtime authorization review, exact Issue #60 marker, runtime
          # identity and duplicate markers, then emit four exact 144-case matrices.
          exit 2
  cases-dep2:
    needs: preflight
    if: ${{ false }}
    strategy:
      fail-fast: false
      max-parallel: 2
      matrix: ${{ fromJSON(needs.preflight.outputs.matrix2) }}
    runs-on: ubuntu-24.04
    steps:
      - run: "exit 2"
  cases-dep4:
    needs: preflight
    if: ${{ false }}
    strategy:
      fail-fast: false
      max-parallel: 2
      matrix: ${{ fromJSON(needs.preflight.outputs.matrix4) }}
    runs-on: ubuntu-24.04
    steps:
      - run: "exit 2"
  cases-dep6:
    needs: preflight
    if: ${{ false }}
    strategy:
      fail-fast: false
      max-parallel: 2
      matrix: ${{ fromJSON(needs.preflight.outputs.matrix6) }}
    runs-on: ubuntu-24.04
    steps:
      - run: "exit 2"
  cases-dep8:
    needs: preflight
    if: ${{ false }}
    strategy:
      fail-fast: false
      max-parallel: 2
      matrix: ${{ fromJSON(needs.preflight.outputs.matrix8) }}
    runs-on: ubuntu-24.04
    steps:
      - run: "exit 2"
