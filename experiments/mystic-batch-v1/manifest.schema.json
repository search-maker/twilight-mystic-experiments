{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/mystic-batch-v1/manifest.schema.json",
  "title": "MYSTIC batch v1 manifest",
  "type": "object",
  "required": [
    "schemaVersion",
    "stageId",
    "batchId",
    "mode",
    "scientificExecution",
    "runtime",
    "limits",
    "frozenInputs",
    "cases"
  ],
  "properties": {
    "schemaVersion": {"const": 1},
    "stageId": {"const": "mystic-batch-v1"},
    "batchId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,79}$"},
    "mode": {"enum": ["synthetic", "scientific"]},
    "scientificExecution": {"type": "boolean"},
    "runtime": {
      "type": "object",
      "required": [
        "python",
        "os",
        "architecture",
        "containerImageDigest",
        "uvspecSha256",
        "libRadtranDataSha256",
        "atmosphereSha256"
      ]
    },
    "limits": {
      "type": "object",
      "required": [
        "maximumCases",
        "maximumParallel",
        "maximumConfiguredMcPhotonsSum",
        "perCaseTimeoutSeconds"
      ]
    },
    "frozenInputs": {"type": "object"},
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["ordinal", "caseId", "seed", "photonHistories"]
      }
    }
  },
  "additionalProperties": false
}
