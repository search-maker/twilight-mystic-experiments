{
  "schemaVersion": 1,
  "stageId": "surrogate-training-v2-candidate-protocol-v1",
  "frozenBeforeInternalHoldout": true,
  "syntheticSuccessDoesNotSelectMysticModelFamily": true,
  "features": [
    "sunDepressionDeg",
    "targetAltitudeDeg",
    "relativeAzimuthDeg",
    "observerElevationM",
    "aod550"
  ],
  "targetTransformation": "natural-log-positive-photopic-luminance",
  "normalization": "training-fold-min-max-with-constant-feature-refusal",
  "crossValidation": {
    "method": "deterministic-five-fold-by-sorted-geometry-id",
    "selectionData": "surrogate-training-only",
    "primaryScore": "mean-absolute-log-error",
    "secondaryScore": "maximum-absolute-log-error",
    "tertiaryScore": "model-complexity-rank",
    "tieTolerance": 1e-12
  },
  "candidates": [
    {
      "candidateId": "transparent-log-mean-baseline",
      "family": "constant-log-radiance",
      "complexityRank": 0,
      "basis": ["intercept"],
      "hyperparameters": [{}],
      "uncertaintyRule": "training-fold-residual-rmse",
      "outOfDomainRule": "outside-any-training-feature-range"
    },
    {
      "candidateId": "fixed-basis-log-ridge",
      "family": "log-radiance-ridge-regression",
      "complexityRank": 1,
      "basis": [
        "intercept",
        "sunDepression",
        "targetAltitude",
        "relativeAzimuth",
        "observerElevation",
        "aod550",
        "sunDepressionSquared",
        "targetAltitudeSquared",
        "sunDepressionTimesTargetAltitude",
        "sunDepressionTimesAod550"
      ],
      "hyperparameters": [
        {"ridge": 1e-8},
        {"ridge": 1e-6},
        {"ridge": 0.0001},
        {"ridge": 0.01}
      ],
      "uncertaintyRule": "training-fold-residual-rmse-plus-0.10-times-nearest-training-distance",
      "outOfDomainRule": "outside-any-training-feature-range-or-nearest-normalized-distance-above-0.80"
    },
    {
      "candidateId": "local-log-idw",
      "family": "local-log-radiance-interpolation",
      "complexityRank": 2,
      "basis": ["normalized-five-dimensional-distance"],
      "hyperparameters": [
        {"neighbors": 4, "power": 1.0},
        {"neighbors": 4, "power": 2.0},
        {"neighbors": 8, "power": 1.0},
        {"neighbors": 8, "power": 2.0}
      ],
      "uncertaintyRule": "weighted-local-log-spread-plus-0.10-times-nearest-training-distance",
      "outOfDomainRule": "outside-any-training-feature-range-or-nearest-normalized-distance-above-0.80"
    }
  ],
  "failureConditions": [
    "dataset-adapter-refusal",
    "fewer-than-ten-training-geometries",
    "non-finite-or-non-positive-target",
    "constant-feature-range",
    "candidate-fit-failure",
    "non-deterministic-regeneration",
    "holdout-opened-before-model-freeze",
    "holdout-used-for-selection-or-threshold-tuning",
    "anchor-used-before-holdout-evaluation",
    "soft-diagnostic-used-as-sole-pass-or-fail-gate"
  ],
  "evaluationOrder": [
    "training-cross-validation",
    "freeze-model-and-thresholds",
    "internal-holdout-once",
    "hard-external-anchors",
    "g01-soft-diagnostic-report-only"
  ],
  "productionBoundary": {
    "productionPromotionAuthorized": false,
    "productionModelReady": false,
    "observationalValidationRequired": true,
    "calibrationObservationsForbidden": true,
    "validationObservationsForbidden": true
  }
}
