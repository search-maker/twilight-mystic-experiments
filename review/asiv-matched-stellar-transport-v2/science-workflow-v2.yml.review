name: ASIV matched stellar v2 fresh validation
run-name: ASIV matched stellar v2 fresh validation ${{ github.ref_name }}

on:
  workflow_dispatch:

permissions:
  contents: read
  actions: read
  pull-requests: read

concurrency:
  group: asiv-matched-stellar-v2-fresh-validation
  cancel-in-progress: false

jobs:
  preflight:
    runs-on: ubuntu-24.04
    timeout-minutes: 90
    outputs:
      matrix: ${{ steps.matrix.outputs.matrix }}
      auth_branch: ${{ steps.identity.outputs.auth_branch }}
      auth_parent: ${{ steps.identity.outputs.auth_parent }}
    steps:
      - name: Checkout exact dispatched v2 authorization head
        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1
        with:
          fetch-depth: 0
          persist-credentials: false

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: '3.12.4'

      - name: Verify one-use v2 dispatch and exact successful authorization review
        id: identity
        shell: bash
        env:
          GH_TOKEN: ${{ github.token }}
        run: |
          set -euo pipefail
          HELPER=review/asiv-matched-stellar-transport-v1/recovery-v4/read_only_gh_api_retry_v4.py
          AUTH_PATH=review/asiv-matched-stellar-transport-v2/authorization-fresh-validation-v2.json
          test "$GITHUB_EVENT_NAME" = workflow_dispatch
          test "$GITHUB_RUN_ATTEMPT" = 1
          test "$GITHUB_RUN_NUMBER" = 1
          test "$GITHUB_REF_NAME" = dispatch/asiv-matched-stellar-transport-v2-fresh-validation
          test "$(git rev-parse HEAD)" = "$GITHUB_SHA"
          python - <<'PY' > auth.env
          import json
          a=json.load(open('review/asiv-matched-stellar-transport-v2/authorization-fresh-validation-v2.json'))
          print(f'AUTH_BRANCH={a.get("authorizationBranch","")}')
          print(f'DISPATCH_BRANCH={a.get("dispatchBranch","")}')
          print(f'AUTH_PARENT_DOC={a.get("exactAuthorizationParentCommit","")}')
          print(f'EXECUTION_KEY={a.get("executionKey","")}')
          PY
          source auth.env
          test "$AUTH_BRANCH" = authorization/asiv-matched-stellar-transport-v2-fresh-validation
          test "$DISPATCH_BRANCH" = "$GITHUB_REF_NAME"
          test "$EXECUTION_KEY" = asiv-matched-stellar-transport-v2-fresh-validation-one-shot
          mapfile -t PARENTS < <(git cat-file -p HEAD | sed -n 's/^parent //p')
          test "${#PARENTS[@]}" = 1
          AUTH_PARENT="${PARENTS[0]}"
          test "$AUTH_PARENT" = "$AUTH_PARENT_DOC"
          mapfile -t CHANGED < <(git diff-tree --no-commit-id --name-only -r HEAD)
          test "${#CHANGED[@]}" = 1
          test "${CHANGED[0]}" = "$AUTH_PATH"
          git fetch origin main "$AUTH_BRANCH" "$GITHUB_REF_NAME"
          test "$(git rev-parse origin/main)" = "$AUTH_PARENT"
          test "$(git rev-parse "origin/$AUTH_BRANCH")" = "$GITHUB_SHA"
          test "$(git rev-parse "origin/$GITHUB_REF_NAME")" = "$GITHUB_SHA"
          export AUTH_BRANCH AUTH_PARENT
          OWNER="${GITHUB_REPOSITORY%%/*}"
          python "$HELPER" --output auth-pr-pages.json -- --paginate --slurp "repos/${GITHUB_REPOSITORY}/pulls?state=all&head=${OWNER}:${AUTH_BRANCH}&per_page=100"
          python - <<'PY'
          import json,os
          pages=json.load(open('auth-pr-pages.json')); prs=[p for page in pages for p in page]
          good=[p for p in prs if (p.get('head') or {}).get('ref')==os.environ['AUTH_BRANCH'] and (p.get('head') or {}).get('sha')==os.environ['GITHUB_SHA']]
          if len(good)!=1: raise SystemExit(f'expected one exact v2 authorization PR; got {len(good)}')
          p=good[0]
          if p.get('state')!='open' or p.get('draft') is not True or p.get('merged_at') is not None or (p.get('base') or {}).get('ref')!='main':
              raise SystemExit('v2 authorization PR must remain Draft/open/unmerged against main')
          open('auth-pr-selected.json','w').write(json.dumps(p,indent=2,sort_keys=True)+'\n')
          PY
          PR_NUMBER="$(python -c 'import json;print(json.load(open("auth-pr-selected.json"))["number"])')"
          python "$HELPER" --output auth-review-pages.json -- --paginate --slurp "repos/${GITHUB_REPOSITORY}/actions/workflows/asiv-matched-stellar-v2-authorization-review.yml/runs?branch=${AUTH_BRANCH}&event=pull_request&per_page=100"
          python - <<'PY'
          import json,os
          pages=json.load(open('auth-review-pages.json')); runs=[r for page in pages for r in page.get('workflow_runs',[])]
          same=[r for r in runs if r.get('head_sha')==os.environ['GITHUB_SHA']]
          good=[r for r in same if int(r.get('run_attempt') or 0)==1 and r.get('status')=='completed' and r.get('conclusion')=='success']
          if len(same)!=1 or len(good)!=1: raise SystemExit(f'v2 authorization review history invalid: same={len(same)} good={len(good)}')
          open('auth-review-selected.json','w').write(json.dumps(good[0],indent=2,sort_keys=True)+'\n')
          PY
          REVIEW_RID="$(python -c 'import json;print(json.load(open("auth-review-selected.json"))["id"])')"
          echo "auth_branch=$AUTH_BRANCH" >> "$GITHUB_OUTPUT"
          echo "auth_parent=$AUTH_PARENT" >> "$GITHUB_OUTPUT"
          echo "pr_number=$PR_NUMBER" >> "$GITHUB_OUTPUT"
          echo "review_run_id=$REVIEW_RID" >> "$GITHUB_OUTPUT"

      - name: Download exact v2 authorization-review receipt
        uses: actions/download-artifact@v4
        with:
          name: asiv-matched-stellar-v2-authorization-review
          path: auth-review-artifact
          repository: ${{ github.repository }}
          run-id: ${{ steps.identity.outputs.review_run_id }}
          github-token: ${{ github.token }}

      - name: Verify v2 receipt, frozen method and exact old training source
        shell: bash
        env:
          GH_TOKEN: ${{ github.token }}
          AUTH_PARENT: ${{ steps.identity.outputs.auth_parent }}
          AUTH_BRANCH: ${{ steps.identity.outputs.auth_branch }}
          PR_NUMBER: ${{ steps.identity.outputs.pr_number }}
        run: |
          set -euo pipefail
          HELPER=review/asiv-matched-stellar-transport-v1/recovery-v4/read_only_gh_api_retry_v4.py
          test -f auth-review-artifact/authorization-review-v2.json
          python - <<'PY'
          import hashlib,importlib.machinery,importlib.util,json,os,subprocess
          from pathlib import Path
          auth_path=Path('review/asiv-matched-stellar-transport-v2/authorization-fresh-validation-v2.json')
          auth=json.loads(auth_path.read_text(encoding='utf-8'))
          receipt=json.load(open('auth-review-artifact/authorization-review-v2.json'))
          raw=auth_path.read_bytes()
          def git_blob(raw): return hashlib.sha1(b'blob '+str(len(raw)).encode()+b'\0'+raw).hexdigest()
          expected={
              'status':'V2_AUTHORIZATION_REVIEW_PASS_NO_DISPATCH',
              'authorizationHeadSha':os.environ['GITHUB_SHA'],
              'authorizationParentSha':os.environ['AUTH_PARENT'],
              'authorizationBranch':os.environ['AUTH_BRANCH'],
              'prNumber':int(os.environ['PR_NUMBER']),
              'authorizationRawSha256':hashlib.sha256(raw).hexdigest(),
              'authorizationGitBlobSha1':git_blob(raw),
              'workflowRunAttempt':1,
              'methodVersion':2,
              'validationCaseCount':768,
              'validationShardCount':24,
              'reusedTrainingSpectrumCount':2700,
              'newTrainingSolverSpectrumCount':0,
              'strictTransportGateVerified':True,
              'freshV2ControlGateVerified':True,
              'oldTrainingArtifactVerified':True,
              'scientificExecutionPerformed':False,
              'solverExecutionPerformed':False,
              'dispatchPerformed':False,
              'pandoraHoldoutOpened':False,
              'starsvisibilityMutationAuthorized':False,
              'productionAuthorized':False,
          }
          for key,value in expected.items():
              if receipt.get(key)!=value: raise SystemExit(f'v2 authorization receipt mismatch: {key}')
          path=Path('review/asiv-matched-stellar-transport-v2/validation_execution_v2.py.review')
          loader=importlib.machinery.SourceFileLoader('v2exec',str(path)); spec=importlib.util.spec_from_loader(loader.name,loader); m=importlib.util.module_from_spec(spec); loader.exec_module(m)
          m.validate_v2_authorization(auth)
          bindings=auth.get('v2ControlBindings') or {}
          paths={
              'scienceWorkflowActiveGitBlobSha1':'.github/workflows/asiv-matched-stellar-v2-fresh-validation.yml',
              'authorizationReviewWorkflowActiveGitBlobSha1':'.github/workflows/asiv-matched-stellar-v2-authorization-review.yml',
              'methodContractGitBlobSha1':'review/asiv-matched-stellar-transport-v2/METHOD_AND_FRESH_VALIDATION_CONTRACT.review.json',
              'interpolationCandidateGitBlobSha1':'review/asiv-matched-stellar-transport-v2/interpolation_candidate_v2.py.review',
              'validationExecutionGitBlobSha1':'review/asiv-matched-stellar-transport-v2/validation_execution_v2.py.review',
              'freshValidatorGitBlobSha1':'review/asiv-matched-stellar-transport-v2/validate_fresh_v2.py.review',
          }
          for key,path in paths.items():
              if bindings.get(key)!=subprocess.check_output(['git','hash-object',path],text=True).strip(): raise SystemExit(f'v2 control binding drift: {key}')
          PY
          python "$HELPER" --output training-artifact.json -- "repos/${GITHUB_REPOSITORY}/actions/artifacts/9580080568"
          python - <<'PY'
          import json
          a=json.load(open('training-artifact.json'))
          if int(a.get('id') or 0)!=9580080568: raise SystemExit('v2 training artifact id drift')
          if a.get('name')!='asiv-matched-stellar-final-validation-recovery-v5': raise SystemExit('v2 training artifact name drift')
          if a.get('digest')!='sha256:bccc9f58a649202c395842df298ace1c4f609badc0d0530e40ba10d8ddc5300f': raise SystemExit('v2 training artifact digest drift')
          run=a.get('workflow_run') or {}
          if int(run.get('id') or 0)!=32889328517 or run.get('head_sha')!='9329c34428438c8796c3aaa652b4ce96d0997f8f': raise SystemExit('v2 training source run/head drift')
          if a.get('expired') is not False: raise SystemExit('v2 training artifact unexpectedly expired')
          PY

      - name: Build exact frozen 24-shard fresh validation matrix
        id: matrix
        shell: bash
        run: |
          set -euo pipefail
          python - <<'PY' >> "$GITHUB_OUTPUT"
          import importlib.machinery,importlib.util,json
          from pathlib import Path
          p=Path('review/asiv-matched-stellar-transport-v2/validation_execution_v2.py.review')
          loader=importlib.machinery.SourceFileLoader('v2exec',str(p)); spec=importlib.util.spec_from_loader(loader.name,loader); m=importlib.util.module_from_spec(spec); loader.exec_module(m)
          batch=m.build_validation_shards()
          if batch['shardCount']!=24 or batch['caseCount']!=768 or batch['trainingCaseCount']!=0: raise SystemExit('v2 fresh validation batch drift')
          print('matrix='+json.dumps({'include':[{'shardId':row['shardId']} for row in batch['shards']]},separators=(',',':')))
          PY

      - name: Fetch exact official OPAC archive once and verify before fresh validation solver
        shell: bash
        run: |
          set -euo pipefail
          mkdir -p execution-preflight
          curl --fail --location --retry 3 --retry-all-errors \
            'https://www.libradtran.org/lib/exe/fetch.php?media=download%3Aoptprop_v2.1.tar.gz' \
            --output execution-preflight/optprop_v2.1.tar.gz
          test "$(stat -c %s execution-preflight/optprop_v2.1.tar.gz)" = 743391266
          printf '%s  %s\n' '11daa1f1f4be0fd4ddf7e881ec2005498049674a1540d37b4b1e8f5e16052c7e' execution-preflight/optprop_v2.1.tar.gz | sha256sum -c -
          cp review/asiv-matched-stellar-transport-v2/authorization-fresh-validation-v2.json execution-preflight/authorization.json
          cp auth-review-artifact/authorization-review-v2.json execution-preflight/authorization-review-v2.json
          cp training-artifact.json execution-preflight/training-artifact-metadata.json

      - name: Publish same-run verified v2 preflight inputs
        uses: actions/upload-artifact@043fb46d1a93c77aae656e7c1c64a875d1fc6a0a
        with:
          name: asiv-matched-stellar-v2-preflight
          path: execution-preflight/
          if-no-files-found: error
          retention-days: 30
          compression-level: 0

  shards:
    needs: preflight
    strategy:
      fail-fast: true
      max-parallel: 8
      matrix: ${{ fromJSON(needs.preflight.outputs.matrix) }}
    runs-on: ubuntu-24.04
    timeout-minutes: 180
    steps:
      - name: Checkout exact dispatched v2 authorization head
        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1
        with:
          persist-credentials: false

      - name: Download exact same-run v2 preflight artifact
        uses: actions/download-artifact@v4
        with:
          name: asiv-matched-stellar-v2-preflight
          path: preflight

      - name: Verify v2 preflight boundary before runtime setup
        shell: bash
        run: |
          set -euo pipefail
          test -f preflight/authorization.json
          test -f preflight/authorization-review-v2.json
          test -f preflight/training-artifact-metadata.json
          test -f preflight/optprop_v2.1.tar.gz
          test "$(stat -c %s preflight/optprop_v2.1.tar.gz)" = 743391266
          printf '%s  %s\n' '11daa1f1f4be0fd4ddf7e881ec2005498049674a1540d37b4b1e8f5e16052c7e' preflight/optprop_v2.1.tar.gz | sha256sum -c -
          python - <<'PY'
          import json
          a=json.load(open('preflight/authorization.json'))
          r=json.load(open('preflight/authorization-review-v2.json'))
          t=json.load(open('preflight/training-artifact-metadata.json'))
          if a.get('trainingExecutionAuthorized') is not False or a.get('validationOnlyExecutionAuthorized') is not True: raise SystemExit('v2 validation-only boundary drift')
          if r.get('freshV2ControlGateVerified') is not True: raise SystemExit('v2 receipt control gate missing')
          if int(t.get('id') or 0)!=9580080568: raise SystemExit('v2 training source metadata drift')
          PY

      - name: Set up exact libRadTran runtime
        uses: mamba-org/setup-micromamba@v2
        with:
          environment-name: matched-stellar-v2-validation
          create-args: -c conda-forge python=3.12.4 rubin-libradtran=2.0.6=py312pl5321he9373c2_1
          cache-environment: true
          cache-downloads: true

      - name: Reconstruct exact OPAC overlay and verify runtime identity
        shell: micromamba-shell {0}
        run: |
          set -euo pipefail
          PYTHONPATH=experiments/aerosol-full-phase-function-sensitivity-v1/execution-candidate python - <<'PY'
          import json,os
          from pathlib import Path
          from runtime_overlay import stage_frozen_overlay
          base=Path(os.environ['CONDA_PREFIX'])/'share/libRadtran/data'
          report=stage_frozen_overlay(base,Path('preflight/optprop_v2.1.tar.gz'),Path('libradtran-overlay'))
          if report.get('augmentedDataTreeSha256')!='5d8bbf8e6b91ec3d405dee36f21a94afbb6e5ec6cd67da2dd5dd541738199d80': raise SystemExit('OPAC overlay drift')
          Path('overlay-report.json').write_text(json.dumps(report,indent=2,sort_keys=True)+'\n')
          PY
          python - <<'PY'
          import hashlib,importlib.util,json,shutil,subprocess
          from pathlib import Path
          payload=json.loads(subprocess.check_output(['micromamba','list','--json'],text=True))
          parser_path=Path('review/asiv-matched-stellar-transport-v1/recovery-v2/micromamba_list_parser_v2.py')
          spec=importlib.util.spec_from_file_location('parser',parser_path); p=importlib.util.module_from_spec(spec); spec.loader.exec_module(p)
          record=p.extract_unique_package_record(payload,'rubin-libradtran')
          observed=p.exact_package_spec(record)
          uvspec=Path(shutil.which('uvspec') or '')
          if not uvspec.is_file(): raise SystemExit('uvspec missing')
          help_run=subprocess.run([str(uvspec),'-h'],capture_output=True,check=True)
          help_sha=hashlib.sha256(help_run.stdout+help_run.stderr).hexdigest()
          if help_sha!='868aea5af762d968f6f62c4e1472916d25232ed9cab5be112d753b0823d20548': raise SystemExit(f'uvspec -h SHA drift: {help_sha}')
          path=Path('review/asiv-matched-stellar-transport-v1/execution_transport_review.py')
          spec=importlib.util.spec_from_file_location('transport',path); m=importlib.util.module_from_spec(spec); spec.loader.exec_module(m)
          report=m.build_runtime_report(
              uvspec=uvspec,
              augmented_data_dir=Path('libradtran-overlay/data'),
              atmosphere_file=Path('libradtran-overlay/data/atmmod/afglus.dat'),
              observed_package_spec=observed,
              observed_uvspec_help_sha256=help_sha,
          )
          report['runtimeHelpInvocation']='-h'
          Path('matched-runtime-report.json').write_text(json.dumps(report,indent=2,sort_keys=True)+'\n')
          PY

      - name: Execute exactly one frozen fresh-validation shard with no retry or resume
        shell: micromamba-shell {0}
        env:
          SHARD_ID: ${{ matrix.shardId }}
        run: |
          set -euo pipefail
          python - <<'PY'
          import importlib.machinery,importlib.util,json,os,shutil
          from pathlib import Path
          p=Path('review/asiv-matched-stellar-transport-v2/validation_execution_v2.py.review')
          loader=importlib.machinery.SourceFileLoader('v2exec',str(p)); spec=importlib.util.spec_from_loader(loader.name,loader); m=importlib.util.module_from_spec(spec); loader.exec_module(m)
          auth=json.load(open('preflight/authorization.json'))
          runtime=json.load(open('matched-runtime-report.json'))
          if runtime.get('runtimeHelpInvocation')!='-h': raise SystemExit('v2 runtime help evidence missing')
          out=Path('shard-output')
          m.execute_validation_shard(
              shard_id=os.environ['SHARD_ID'], authorization=auth, runtime_report=runtime,
              output_root=out, allow_execution=True,
          )
          shutil.copy2('matched-runtime-report.json',out/'runtime-report.json')
          shutil.copy2('overlay-report.json',out/'overlay-report.json')
          PY

      - name: Persist complete fresh-validation shard only after full success
        uses: actions/upload-artifact@043fb46d1a93c77aae656e7c1c64a875d1fc6a0a
        with:
          name: asiv-matched-stellar-v2-fresh-shard-${{ matrix.shardId }}
          path: shard-output/
          if-no-files-found: error
          retention-days: 90
          compression-level: 0

  aggregate:
    if: ${{ always() && needs.preflight.result == 'success' && needs.shards.result == 'success' }}
    needs: [preflight, shards]
    runs-on: ubuntu-24.04
    timeout-minutes: 120
    steps:
      - name: Checkout exact dispatched v2 authorization head
        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1
        with:
          persist-credentials: false

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: '3.12.4'

      - name: Download all 24 same-run fresh validation shard artifacts
        uses: actions/download-artifact@v4
        with:
          pattern: asiv-matched-stellar-v2-fresh-shard-*
          path: shard-artifacts
          merge-multiple: false

      - name: Verify exact local 24-shard fresh validation universe
        shell: bash
        run: |
          set -euo pipefail
          python - <<'PY'
          import json
          from pathlib import Path
          root=Path('shard-artifacts')
          rows=sorted([p for p in root.iterdir() if p.is_dir() and p.name.startswith('asiv-matched-stellar-v2-fresh-shard-')]) if root.is_dir() else []
          names=[p.name for p in rows]
          if len(rows)!=24 or len(set(names))!=24: raise SystemExit(f'exactly 24 unique v2 fresh shard directories required; got {len(rows)}')
          Path('shard-artifacts-local-v2.json').write_text(json.dumps({'artifactDirectories':names},indent=2,sort_keys=True)+'\n')
          PY

      - name: Download exact already-open v5 training LUT source
        uses: actions/download-artifact@v4
        with:
          name: asiv-matched-stellar-final-validation-recovery-v5
          path: training-source-v5
          repository: ${{ github.repository }}
          run-id: '32889328517'
          github-token: ${{ github.token }}

      - name: Validate exact fresh 768-case universe against frozen v2 method
        shell: bash
        run: |
          set -euo pipefail
          test -f training-source-v5/matched-stellar-final-validation-recovery-v5.json
          python - <<'PY'
          import importlib.machinery,importlib.util,json
          from pathlib import Path
          p=Path('review/asiv-matched-stellar-transport-v2/validate_fresh_v2.py.review')
          loader=importlib.machinery.SourceFileLoader('v2validate',str(p)); spec=importlib.util.spec_from_loader(loader.name,loader); m=importlib.util.module_from_spec(spec); loader.exec_module(m)
          roots=sorted([x for x in Path('shard-artifacts').iterdir() if x.is_dir() and x.name.startswith('asiv-matched-stellar-v2-fresh-shard-')])
          if len(roots)!=24: raise SystemExit('v2 fresh shard universe incomplete')
          result=m.validate_fresh_v2(
              shard_roots=roots,
              v5_final_json_path=Path('training-source-v5/matched-stellar-final-validation-recovery-v5.json'),
              sed_bundle_path=Path('review/asiv-matched-stellar-transport-v1/frozen-assets/pickles-sed-1nm.json'),
              johnson_v_path=Path('review/asiv-matched-stellar-transport-v1/frozen-assets/johnson-v-1nm.json'),
          )
          result['workflowRunId']=int('${{ github.run_id }}')
          result['workflowRunAttempt']=int('${{ github.run_attempt }}')
          result['freshShardArtifactCount']=24
          result['freshScientificCaseCount']=768
          result['reusedTrainingSpectrumCount']=2700
          result['newTrainingSolverSpectrumCount']=0
          result['githubRerun']=False
          result['solverRetryPerformed']=False
          result['solverResumePerformed']=False
          result['pandoraHoldoutOpened']=False
          result['starsvisibilityMutationAuthorized']=False
          result['productionAuthorized']=False
          Path('matched-stellar-v2-fresh-validation.json').write_text(json.dumps(result,indent=2,sort_keys=True,allow_nan=False)+'\n')
          print(json.dumps({'status':result.get('status'),'allFamiliesPassed':result.get('allFamiliesPassed'),'freshCaseCount':768,'methodVersion':2},sort_keys=True))
          PY

      - name: Publish complete final v2 fresh-validation evidence only
        uses: actions/upload-artifact@043fb46d1a93c77aae656e7c1c64a875d1fc6a0a
        with:
          name: asiv-matched-stellar-v2-fresh-validation
          path: |
            matched-stellar-v2-fresh-validation.json
            shard-artifacts-local-v2.json
          if-no-files-found: error
          retention-days: 90
          compression-level: 0
