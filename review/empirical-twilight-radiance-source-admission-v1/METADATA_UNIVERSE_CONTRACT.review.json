{
  "schemaVersion": 1,
  "stageId": "empirical-twilight-radiance-metadata-universe-contract-v1",
  "status": "REVIEW_ONLY_UNIVERSE_SCHEMA_AND_SELECTION_SEMANTICS_FROZEN_NO_PANDORA_TARGET_VALUES_OPENED",
  "purpose": "Freeze the normalized metadata-only row schema, transition/session grouping, inclusion ordering and provenance needed to build the complete empirical candidate universe after PGN field mappings are resolved, without inspecting target radiance or target per-pixel uncertainty arrays.",
  "targetRadianceOpened": false,
  "universePrinciple": {
    "completeApplicableValidityWindows": true,
    "retainEligibleAndRejectedRows": true,
    "retainEveryMetadataEligibleIndependentSession": true,
    "minimumIndependentSessionsForTerminalPass": 40,
    "mayTrimLargerEligibleUniverseToBestForty": false,
    "maySelectByTargetBrightness": false,
    "maySelectByModelResidual": false,
    "maySelectByNearestAerosolScenario": false,
    "maySelectByPostOpeningDataCompleteness": false
  },
  "normalizedRowRequiredFields": [
    "sourceObjectId",
    "sourcePathOrProviderObjectId",
    "siteId",
    "instrumentId",
    "spectrometerId",
    "measurementStartUtc",
    "durationSeconds",
    "exposureIdentity",
    "routineIdentity",
    "level1DataType",
    "calibrationBindingId",
    "operationBindingId",
    "pointingAzimuthAngleDeg",
    "pointingAzimuthMode",
    "pointingZenithAngleDeg",
    "pointingZenithMode",
    "absoluteTruePointingResolved",
    "truePointingAzimuthDeg",
    "truePointingZenithDeg",
    "sunDepressionDeg",
    "targetAltitudeDeg",
    "relativeSolarAzimuthDeg",
    "twilightPhase",
    "transitionIdentity",
    "externalAodIntervalLow",
    "externalAodIntervalHigh",
    "externalAodQcStatus",
    "cloudQcStatus",
    "baseModelContinuousAodSupportStatus",
    "absoluteRadianceCalibrationStatus",
    "wavelengthValidityStatus",
    "metadataIdentitySha256"
  ],
  "allowedTwilightPhases": ["EVENING", "MORNING"],
  "sessionIdentity": {
    "oneIndependentSession": "one astronomical dawn or dusk transition at one site",
    "transitionIdentityMustBeDerivedWithoutTargetValues": true,
    "transitionIdentityMustBindSiteAndSpecificSunsetOrSunriseEvent": true,
    "allRowsFromSameTransitionShareSessionIdentity": true,
    "rowsFromDifferentDatesOrOppositeDawnDuskTransitionsMayNotShareSessionIdentity": true
  },
  "strictRowAdmission": {
    "siteId": "Izana",
    "instrumentId": "209",
    "level1DataType": 2,
    "sunDepressionDegInclusive": [2.0, 10.5],
    "targetAltitudeDegInclusive": [5.0, 80.0],
    "relativeSolarAzimuthDegInclusive": [0.0, 180.0],
    "externalAodIntervalInclusive": [0.05, 0.40],
    "absoluteTruePointingResolvedRequired": true,
    "externalAodQcStatusRequired": "PASS",
    "cloudQcStatusRequired": "PASS_CLEAR",
    "baseModelContinuousAodSupportStatusRequired": "PASS",
    "absoluteRadianceCalibrationStatusRequired": "PASS",
    "wavelengthValidityStatusRequired": "PASS_FOR_LANE",
    "calibrationBindingIdRequired": true,
    "operationBindingIdRequired": true
  },
  "rejectionReasonVocabulary": [
    "WRONG_SITE_OR_INSTRUMENT",
    "SPECTROMETER_NOT_ALLOWED_FOR_LANE",
    "NOT_LEVEL1_TYPE2_RADIANCE",
    "UNRESOLVED_TRUE_POINTING",
    "GEOMETRY_OUT_OF_DOMAIN",
    "MISSING_OR_INVALID_CALIBRATION_BINDING",
    "MISSING_OR_INVALID_OPERATION_BINDING",
    "ABSOLUTE_RADIANCE_CALIBRATION_NOT_PROVEN",
    "WAVELENGTH_VALIDITY_NOT_PROVEN_FOR_LANE",
    "AOD_INTERVAL_OUT_OF_DOMAIN",
    "EXTERNAL_AOD_QC_FAILED_OR_UNRESOLVED",
    "CLOUD_QC_FAILED_OR_UNRESOLVED",
    "BASE_MODEL_CONTINUOUS_AOD_SUPPORT_FAILED",
    "MISSING_REQUIRED_METADATA",
    "DUPLICATE_SOURCE_OBJECT_ID",
    "INVALID_METADATA_IDENTITY_HASH"
  ],
  "canonicalOutput": {
    "rowOrder": "lexicographic by sourceObjectId",
    "sessionOrder": "lexicographic by transitionIdentity",
    "includeRejectedRows": true,
    "includeRejectionReasons": true,
    "includeMetadataIdentityHashes": true,
    "canonicalJsonSha256Required": true,
    "sourceInventorySnapshotHashRequired": true,
    "externalAodQcSnapshotHashRequired": true,
    "cloudQcSnapshotHashRequired": true,
    "calibrationOperationSnapshotHashRequired": true
  },
  "laneRules": {
    "PANDORA209_S2_JOHNSON_V_ONLY_V1": {
      "allowedSpectrometers": [2],
      "requiresCrossSpectrometerPairing": false,
      "minimumAbsoluteRadianceValidWavelengthNm": [470.0, 700.0]
    },
    "PANDORA209_S1S2_THREE_CHANNEL_V1": {
      "allowedSpectrometers": [1, 2],
      "requiresCrossSpectrometerPairing": true,
      "requiresDirectionalCompatibility": true,
      "minimumCombinedAbsoluteRadianceValidWavelengthNm": [380.0, 780.0]
    }
  },
  "protectedFieldBoundary": {
    "forbiddenInNormalizedMetadataRows": [
      "LEVEL1.DATA values",
      "LEVEL1.UNCERTAINTY values",
      "LEVEL1.UNCERTAINTY.INSTRUMENT values",
      "integrated observed photopic/scotopic/Johnson-V values",
      "target radiance statistics",
      "model residuals against target radiance"
    ],
    "metadataHeadersAndIdentitiesAllowed": true,
    "dataTypeCodeAllowed": true,
    "uncertaintyFieldExistenceAllowed": true,
    "uncertaintyArrayValuesAllowed": false
  },
  "authorization": {
    "targetRadianceOpeningAuthorized": false,
    "targetDownloadAuthorized": false,
    "scientificExecutionAuthorized": false,
    "modelRetuningAuthorized": false,
    "productionActivationAuthorized": false
  }
}
