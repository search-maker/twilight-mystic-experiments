  "empiricalValidationInterpretation": {
    "primaryQuestion": "Does the already-frozen Level-B v3 sky model, including its fixed AFGLUS/albedo/aerosol-default assumptions and only its declared runtime axes, reproduce independent absolute real-sky integrated radiance within preregistered empirical gates?",
