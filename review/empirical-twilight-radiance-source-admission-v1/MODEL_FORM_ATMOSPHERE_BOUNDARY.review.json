    "mayUseExternalNonRuntimeAtmosphereMeasurementsAsDiagnostics": true,
    "diagnosticsMayChangePrimaryPassFail": false,
    "diagnosticsMayRetuneCurrentModelGeneration": false,
    "residualsCausedByFixedModelFormRemainPartOfEmpiricalError": true,
    "reason": "real-sky validation must test the production-intended frozen physical representation rather than condition the validation source onto hidden parameters the runtime cannot supply"
  },
  "recommendedExternalDiagnosticsToCaptureWithoutSelectionOnOutcome": {
    "precipitableWater": {
