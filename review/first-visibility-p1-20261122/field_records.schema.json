{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/search-maker/twilight-mystic-experiments/review/first-visibility-p1-20261122/field_records.schema.json",
  "title": "P1-FVS-20261122 original unaided first-sighting event manifest (blank schema, NOT participant data)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_id",
    "protocol_status",
    "model_sha",
    "records",
    "attempts",
    "source_manifest",
    "has_real_observer_data"
  ],
  "properties": {
    "protocol_id": {
      "const": "P1-FVS-20261122-R0"
    },
    "protocol_status": {
      "enum": [
        "REVIEW_DRAFT_NO_ENROLLMENT",
        "APPROVED_PRE_OUTCOME",
        "RAW_LOCKED_PENDING_UNBLIND",
        "UNBLINDED_ANALYSIS"
      ]
    },
    "model_sha": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      ]
    },
    "has_real_observer_data": {
      "type": "boolean"
    },
    "source_manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "catalog_sha256",
        "ephemeris_sha256",
        "atmosphere_manifest_sha256",
        "source_custodian",
        "catalog_source",
        "source_version",
        "access_permission"
      ],
      "properties": {
        "catalog_sha256": {
          "$ref": "#/$defs/shaOrNull"
        },
        "ephemeris_sha256": {
          "$ref": "#/$defs/shaOrNull"
        },
        "atmosphere_manifest_sha256": {
          "$ref": "#/$defs/shaOrNull"
        },
        "source_custodian": {
          "type": [
            "string",
            "null"
          ]
        },
        "catalog_source": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "access_permission": {
          "enum": [
            "UNVERIFIED",
            "PERMITTED",
            "DENIED"
          ]
        }
      }
    },
    "attempts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "attempt_id",
          "site_id",
          "night_local",
          "observer_id",
          "status",
          "reason",
          "original_log_sha256"
        ],
        "properties": {
          "attempt_id": {
            "type": "string",
            "minLength": 1
          },
          "site_id": {
            "$ref": "#/$defs/privateId"
          },
          "night_local": {
            "type": "string",
            "format": "date"
          },
          "observer_id": {
            "$ref": "#/$defs/privateId"
          },
          "status": {
            "enum": [
              "NOT_STARTED",
              "CLOUD_ABORT",
              "CLOCK_ABORT",
              "SAFETY_ABORT",
              "COMPLETED",
              "MISSING",
              "NOT_ELIGIBLE"
            ]
          },
          "reason": {
            "type": [
              "string",
              "null"
            ]
          },
          "original_log_sha256": {
            "$ref": "#/$defs/shaOrNull"
          }
        }
      }
    },
    "records": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/record"
      }
    }
  },
  "$defs": {
    "shaOrNull": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      ]
    },
    "privateId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 72,
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "clock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "utc",
        "uncertainty_seconds",
        "sync_method"
      ],
      "properties": {
        "utc": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "uncertainty_seconds": {
          "type": "number",
          "minimum": 0
        },
        "sync_method": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "look": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "timestamp",
        "status",
        "star_alt_deg",
        "star_az_deg",
        "sun_depth_deg",
        "cloud_direction",
        "adapted_minutes",
        "screen_light_seconds_last_15m"
      ],
      "properties": {
        "timestamp": {
          "$ref": "#/$defs/clock"
        },
        "status": {
          "enum": [
            "NOT_SEEN",
            "POSSIBLE",
            "AVERTED_SEEN",
            "DIRECT_SEEN",
            "CLOUD_OBSCURED",
            "NOT_CHECKED"
          ]
        },
        "star_alt_deg": {
          "type": [
            "number",
            "null"
          ],
          "minimum": -90,
          "maximum": 90
        },
        "star_az_deg": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "exclusiveMaximum": 360
        },
        "sun_depth_deg": {
          "type": [
            "number",
            "null"
          ]
        },
        "cloud_direction": {
          "enum": [
            "CLEAR",
            "THIN",
            "PATCHY",
            "OPAQUE",
            "UNKNOWN"
          ]
        },
        "adapted_minutes": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "screen_light_seconds_last_15m": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "notes": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_id",
        "attempt_id",
        "site_id",
        "observer_id",
        "night_local",
        "hip",
        "v_mag",
        "target_altitude_selection_deg",
        "site_private_metadata_sha256",
        "consent_receipt_private_sha256",
        "source_log_sha256",
        "look_events",
        "skyglow",
        "aerosol",
        "weather",
        "outcome_admission",
        "censor_reason"
      ],
      "properties": {
        "record_id": {
          "$ref": "#/$defs/privateId"
        },
        "attempt_id": {
          "$ref": "#/$defs/privateId"
        },
        "site_id": {
          "$ref": "#/$defs/privateId"
        },
        "observer_id": {
          "$ref": "#/$defs/privateId"
        },
        "night_local": {
          "type": "string",
          "format": "date"
        },
        "hip": {
          "type": "integer",
          "minimum": 1
        },
        "v_mag": {
          "type": "number",
          "minimum": -2,
          "maximum": 10
        },
        "target_altitude_selection_deg": {
          "type": "number",
          "minimum": 20,
          "maximum": 80
        },
        "site_private_metadata_sha256": {
          "$ref": "#/$defs/shaOrNull"
        },
        "consent_receipt_private_sha256": {
          "$ref": "#/$defs/shaOrNull"
        },
        "source_log_sha256": {
          "$ref": "#/$defs/shaOrNull"
        },
        "look_events": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/look"
          }
        },
        "skyglow": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "value",
            "units",
            "view_alt_deg",
            "view_az_deg",
            "fov_deg",
            "calibration_sha256"
          ],
          "properties": {
            "status": {
              "enum": [
                "UNKNOWN",
                "MEASURED",
                "CLOUD_INVALID"
              ]
            },
            "value": {
              "type": [
                "number",
                "null"
              ]
            },
            "units": {
              "type": [
                "string",
                "null"
              ]
            },
            "view_alt_deg": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0,
              "maximum": 90
            },
            "view_az_deg": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0,
              "exclusiveMaximum": 360
            },
            "fov_deg": {
              "type": [
                "number",
                "null"
              ],
              "exclusiveMinimum": 0
            },
            "calibration_sha256": {
              "$ref": "#/$defs/shaOrNull"
            }
          }
        },
        "aerosol": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source",
            "aod550",
            "utc",
            "qc",
            "source_sha256"
          ],
          "properties": {
            "source": {
              "type": [
                "string",
                "null"
              ]
            },
            "aod550": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            },
            "utc": {
              "type": [
                "string",
                "null"
              ],
              "format": "date-time"
            },
            "qc": {
              "enum": [
                "UNKNOWN",
                "PASS",
                "FAIL",
                "NOT_COINCIDENT"
              ]
            },
            "source_sha256": {
              "$ref": "#/$defs/shaOrNull"
            }
          }
        },
        "weather": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "temperature_c",
            "rh_percent",
            "pressure_hpa",
            "moon_separation_deg",
            "moon_phase_fraction",
            "directional_horizon_alt_deg"
          ],
          "properties": {
            "temperature_c": {
              "type": [
                "number",
                "null"
              ]
            },
            "rh_percent": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0,
              "maximum": 100
            },
            "pressure_hpa": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            },
            "moon_separation_deg": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0,
              "maximum": 180
            },
            "moon_phase_fraction": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0,
              "maximum": 1
            },
            "directional_horizon_alt_deg": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0,
              "maximum": 90
            }
          }
        },
        "outcome_admission": {
          "enum": [
            "UNREVIEWED",
            "BRACKET_QUALIFIED",
            "CENSORED",
            "REJECT_CLOCK",
            "REJECT_DIRECTIONAL_CLOUD",
            "REJECT_CONSENT",
            "REJECT_MISSING_SOURCE",
            "REJECT_NO_PRIOR_NOT_SEEN",
            "REJECT_NO_CONFIRMATION",
            "REJECT_WIDE_BRACKET",
            "REJECT_GEOMETRY",
            "REJECT_OTHER"
          ]
        },
        "censor_reason": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
