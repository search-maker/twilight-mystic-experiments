{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "P1 human unaided first-onset event, nonregistered prospective field form",
  "type": "object",
  "required": [
    "event_id",
    "observer_token",
    "site_token",
    "target_catalog_id",
    "v_mag",
    "visual_mode",
    "consent_verified",
    "site_permission_verified",
    "prediction_blinded",
    "clock_error_sec",
    "adaptation_started_utc",
    "site",
    "pointing",
    "conditions",
    "checks",
    "raw_record_uri",
    "raw_sha256"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "observer_token": {
      "type": "string",
      "minLength": 1
    },
    "site_token": {
      "type": "string",
      "minLength": 1
    },
    "target_catalog_id": {
      "type": "string",
      "pattern": "^(HIP|HD|HR)-[0-9]+$"
    },
    "v_mag": {
      "type": "number",
      "minimum": -2,
      "maximum": 9
    },
    "visual_mode": {
      "const": "NAKED_EYE"
    },
    "consent_verified": {
      "const": true
    },
    "site_permission_verified": {
      "const": true
    },
    "prediction_blinded": {
      "const": true
    },
    "clock_error_sec": {
      "type": "number",
      "minimum": 0,
      "maximum": 5
    },
    "adaptation_started_utc": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "site": {
      "type": "object",
      "required": [
        "lat_deg",
        "lon_deg",
        "elevation_m",
        "horizon_target_deg",
        "coordinate_uncertainty_m"
      ],
      "properties": {
        "lat_deg": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "lon_deg": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        "elevation_m": {
          "type": "number"
        },
        "horizon_target_deg": {
          "type": "number",
          "minimum": -5,
          "maximum": 90
        },
        "coordinate_uncertainty_m": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "pointing": {
      "type": "object",
      "required": [
        "star_alt_deg",
        "star_az_deg",
        "solar_depression_deg",
        "ephemeris_id",
        "catalog_revision"
      ],
      "properties": {
        "star_alt_deg": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "star_az_deg": {
          "type": "number",
          "minimum": 0,
          "exclusiveMaximum": 360
        },
        "solar_depression_deg": {
          "type": "number",
          "minimum": 0,
          "maximum": 30
        },
        "ephemeris_id": {
          "type": "string",
          "minLength": 1
        },
        "catalog_revision": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "conditions": {
      "type": "object",
      "required": [
        "target_cloud",
        "aod550",
        "aod_source_uri",
        "aod_quality_flag",
        "skyglow_measurements"
      ],
      "properties": {
        "target_cloud": {
          "enum": [
            "CLEAR",
            "PARTIAL",
            "OBSCURED",
            "UNKNOWN"
          ]
        },
        "cloud_octas_whole_sky": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 8
        },
        "aod550": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "aod_source_uri": {
          "type": [
            "string",
            "null"
          ]
        },
        "aod_quality_flag": {
          "enum": [
            "VERIFIED",
            "UNKNOWN",
            "BAD"
          ]
        },
        "temperature_c": {
          "type": [
            "number",
            "null"
          ]
        },
        "relative_humidity_pct": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 100
        },
        "moon_alt_deg": {
          "type": [
            "number",
            "null"
          ],
          "minimum": -90,
          "maximum": 90
        },
        "local_light_sources": {
          "type": [
            "string",
            "null"
          ]
        },
        "skyglow_measurements": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "utc",
              "mpsas",
              "pointing_alt_deg",
              "pointing_az_deg",
              "instrument",
              "fwhm_deg",
              "calibration_id"
            ],
            "properties": {
              "utc": {
                "type": "string",
                "format": "date-time",
                "pattern": "Z$"
              },
              "mpsas": {
                "type": "number"
              },
              "pointing_alt_deg": {
                "type": "number"
              },
              "pointing_az_deg": {
                "type": "number"
              },
              "instrument": {
                "type": "string"
              },
              "fwhm_deg": {
                "type": "number"
              },
              "calibration_id": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        }
      }
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "utc",
          "state",
          "visual_aid"
        ],
        "properties": {
          "utc": {
            "type": "string",
            "format": "date-time",
            "pattern": "Z$"
          },
          "state": {
            "enum": [
              "NO",
              "YES",
              "CONFIRM"
            ]
          },
          "visual_aid": {
            "const": "NONE"
          }
        }
      }
    },
    "raw_record_uri": {
      "type": "string",
      "minLength": 1
    },
    "raw_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
