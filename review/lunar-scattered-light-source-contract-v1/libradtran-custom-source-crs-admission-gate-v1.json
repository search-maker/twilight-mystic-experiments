{
  "schemaVersion": 1,
  "contractId": "libradtran-custom-source-crs-admission-gate-v1",
  "status": "PREREGISTERED_BEFORE_RUNTIME_PROBE",
  "purpose": "Resolve, on the exact frozen libRadtran runtime, whether source solar <file> is actually consumed when mol_abs_param crs is active before any lunar MYSTIC atmospheric-scattering execution is admitted.",
  "documentationConflict": {
    "source": "libRadtran User's Guide 2.0.6, 2025-02-02",
    "url": "https://www.libradtran.org/doc/libRadtran.pdf",
    "observations": [
      "The crs spectral-resolution description says transmittance is interpolated to wavelengths in the source solar file and multiplied by extraterrestrial irradiance from that file.",
      "The source option description says the file argument is ignored when mol_abs_param other than lowtran or reptran is specified, which literally includes crs."
    ],
    "resolutionRule": "Do not choose between conflicting documentation sentences. Require a version-bound runtime capability probe."
  },
  "exactRuntime": {
    "distribution": "conda-forge",
    "package": "rubin-libradtran",
    "versionBuild": "2.0.6=py312pl5321he9373c2_1",
    "python": "3.12.4",
    "uvspecSha256": "2b9c7a69e4dfe4e77ade97148b2499b0a2c205c8d8000d3516a29344cc9d2fc3",
    "libRadtranDataTreeSha256": "ad30b49177e9c84e46497d69faf0c75e466996b0d0003f1de210289ae9f847d7",
    "runtimeLock": "experiments/mystic-batch-v1/runtime-lock.micromamba.json",
    "runtimeProbe": "experiments/mystic-batch-v1/runtime_probe.py"
  },
  "probe": {
    "classification": "NON_SCIENTIFIC_SOURCE_BINDING_CAPABILITY_PROBE",
    "mysticExecuted": false,
    "realSkyDataOpened": false,
    "arms": {
      "A": {
        "sourceFluxValues": [1.0, 1.0, 1.0]
      },
      "B": {
        "sourceFluxValues": [7.0, 7.0, 7.0]
      }
    },
    "sourceWavelengthNm": [380.0, 550.0, 780.0],
    "sourceFluxUnit": "mW m-2 nm-1",
    "onlyIntentionalDifference": "source-file flux amplitude and source filename",
    "commonInputRequirements": [
      "data_files_path <exact-bound-data-tree>",
      "atmosphere_file <exact-bound-data-tree>/atmmod/afglus.dat",
      "source solar <arm-specific-source-file>",
      "mol_abs_param crs",
      "wavelength 380 780",
      "sza 0",
      "albedo 0",
      "rte_solver disort",
      "number_of_streams 4",
      "zout TOA",
      "output_user lambda edir",
      "quiet"
    ]
  },
  "frozenDecisionRule": {
    "expectedArmBToArmARatio": 7.0,
    "maximumAbsoluteRatioDeviation": 0.01,
    "requirements": [
      "Both arms must exit zero.",
      "Both outputs must contain the same non-empty wavelength vector.",
      "Every Arm A direct irradiance value used in the ratio must be finite and strictly positive.",
      "Every Arm B value and every B/A ratio must be finite.",
      "The absolute deviation of every B/A ratio from 7.0 must be <= 0.01."
    ],
    "ifPass": "CUSTOM_SOURCE_WITH_CRS_CONSUMPTION_PROVEN_FOR_EXACT_RUNTIME_TUPLE_ONLY",
    "ifFail": "CURRENT_CRS_CUSTOM_SOURCE_ROUTE_BLOCKED_FOR_LUNAR_ATMOSPHERIC_SCATTERING",
    "noPostResultToleranceChange": true,
    "noSilentFallback": true
  },
  "fallbackBoundary": {
    "candidateStrategiesNotAuthorizedByThisContract": [
      "lowtran custom-source route",
      "reptran custom-source route",
      "wavelength-by-wavelength transfer-kernel scaling"
    ],
    "requireSeparatePreregistrationBeforeUse": true
  },
  "scientificBoundaries": {
    "noTaylorOrJerusalemResidualUse": true,
    "noAirLusiResidualOpening": true,
    "noXshooterResidualOpening": true,
    "atmosphericScatteredMoonlightValidatedByThisProbe": false,
    "productionAuthorized": false
  }
}
