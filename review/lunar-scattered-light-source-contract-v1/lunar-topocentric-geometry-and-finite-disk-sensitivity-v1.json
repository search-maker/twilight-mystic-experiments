{
  "schemaVersion": 1,
  "contractId": "lunar-topocentric-geometry-and-finite-disk-sensitivity-v1",
  "status": "PREREGISTERED_GEOMETRY_AND_EXTENDED_SOURCE_SENSITIVITY_NO_RESIDUALS_OPENED",
  "purpose": "Prevent geocentric/apparent-position and point-source shortcuts from being silently treated as validated lunar atmospheric-scattering geometry.",
  "geometryBoundary": {
    "sourceDirection": "TOPOCENTRIC_VACUUM_MOON_CENTER_DIRECTION_AT_OBSERVER",
    "geocentricMoonDirectionAllowedForAtmosphericValidation": false,
    "observerLocationMustIncludeLatitudeLongitudeElevation": true,
    "observerElevationMustMatchAtmosphereGroundRepresentation": true,
    "atmosphericRefractionAppliedToSourceDirection": false,
    "reasonRefractionDisabled": "MYSTIC source rays in this contract are straight vacuum-to-atmosphere rays; using a refracted apparent Moon altitude would double-count or inconsistently introduce refraction that the radiative-transfer geometry does not model.",
    "lightTimeAberrationAndEphemerisSemanticsMustBeExplicit": true,
    "archiveTimestampSemanticsMustBeConfirmedBeforeEvaluation": true,
    "targetPointingSemanticsMustBeConfirmedBeforeEvaluation": true,
    "noTimeOrDirectionAdjustmentFromMysticResiduals": true
  },
  "separationBoundary": {
    "publishedNominalMoonSeparationUsedForCaseLabelsOnly": true,
    "validationSeparationMustBeRecomputedFromFrozenVacuumDirections": true,
    "sphericalAngularSeparationRequired": true,
    "smallAnglePlanarApproximationAllowedForFinalSeparation": false
  },
  "finiteDiskBoundary": {
    "roloSourceQuantity": "DISK_INTEGRATED_EXTRATERRESTRIAL_LUNAR_IRRADIANCE",
    "centralCollimatedRunUsesFullDiskIntegratedIrradiance": true,
    "multiplySourceByLunarSolidAngle": false,
    "centralCollimatedRunMayClaimFiniteDiskModeled": false,
    "finiteDiskAngularRadiusMustComeFromFrozenObserverMoonDistance": true,
    "fixedAngularRadiusDegForbiddenWhenDistanceIsAvailable": true,
    "resolvedLunarRadianceMapRequiredForPhysicalDiskIntegration": true,
    "uniformDiskMayBeUsedAsPhysicalTruthWithoutSeparateJustification": false,
    "phaseDependentBrightnessDistributionMayBeInferredFromXshooterResiduals": false
  },
  "preregisteredSensitivitySampling": {
    "role": "RESULT_BLIND_POINT_SOURCE_APPROXIMATION_SENSITIVITY_ONLY",
    "sourceFluxAtEverySample": "same full disk-integrated ROLO irradiance; each run is a hypothetical collimated unit-direction transfer response, not a partition of the lunar flux",
    "diskTangentPlane": "centered on frozen topocentric vacuum Moon-center direction",
    "sampleRadiiInLunarRadius": [0.0, 0.5, 1.0],
    "azimuthSamplesPerNonzeroRing": 16,
    "azimuthOriginDeg": 0.0,
    "azimuthStepDeg": 22.5,
    "totalDirectionalRunsPerAtmosphereTargetWavelengthConfiguration": 33,
    "sameAtmosphereTargetAndSpectralSourceRequiredAcrossAllDirections": true,
    "samePhotonBudgetPerDirectionRequired": true,
    "freshIndependentSeedsRequired": true,
    "noDirectionMayBeAddedOrRemovedFromObservedResiduals": true,
    "reportedDiagnostics": [
      "central_direction_radiance",
      "minimum_sampled_direction_radiance",
      "maximum_sampled_direction_radiance",
      "sampled_range_fraction_of_central",
      "maximum_absolute_sampled_deviation_fraction_of_central",
      "ringwise_minimum_maximum_and_mean"
    ],
    "acceptanceThresholdInventedHere": false,
    "interpretation": "This samples directional sensitivity across the physical lunar disk support. It does not by itself reconstruct the true resolved lunar disk, and finite sampling is not represented as a mathematical continuous-disk extremum proof."
  },
  "extendedSourceLogic": {
    "radiativeTransferLinearityMayBeUsed": true,
    "nonnegativeResolvedDiskRadianceWouldFormWeightedDirectionalCombination": true,
    "sampledEnvelopeMayBeUsedAsSensitivityDiagnostic": true,
    "sampledEnvelopeMayBeCalledRigorousContinuousDiskBound": false,
    "physicalExtendedDiskProviderAuthorized": false
  },
  "xshooterUse": {
    "primaryClearStratumMinimumNominalSeparationDeg": 13,
    "sevenDegreeCasesRemainStressStratum": true,
    "finiteDiskSensitivityMustBeReportedSeparatelyForStressAndPrimaryStrata": true,
    "pointSourceApproximationMayNotBeRetrospectivelyAcceptedBecauseItMatchesXshooter": true
  },
  "openingGate": {
    "ephemerisImplementationFrozenAndAudited": false,
    "archiveTimestampSemanticsConfirmed": false,
    "targetPointingSemanticsConfirmed": false,
    "finiteDiskSensitivityExecuted": false,
    "physicalResolvedDiskIntegrationImplemented": false,
    "mysticResidualsOpened": false,
    "atmosphericScatteredMoonlightValidated": false,
    "productionAuthorized": false
  }
}
