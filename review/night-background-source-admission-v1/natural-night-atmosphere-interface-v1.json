{
  "schemaVersion": 1,
  "contractId": "natural-night-atmosphere-interface-v1",
  "status": "PREREGISTERED_INTERFACE_NO_PROVIDER_PROMOTION_NO_RESIDUALS_OPENED",
  "purpose": "Prevent double attenuation/scattering and false same-atmosphere claims when combining astrophysical natural-sky sources, airglow, and the Level-B atmosphere.",
  "coreRule": {
    "sameAtmosphereIdentityStringAloneIsSufficient": false,
    "atmosphereTreatmentMustBeExplicit": true,
    "componentMayBeAtmosphericallyPropagatedExactlyOnce": true,
    "doubleAttenuationOrScatteringForbidden": true,
    "residualBasedChoiceOfAtmosphereTreatmentForbidden": true
  },
  "admissibleProviderModes": {
    "SOURCE_ONLY_SHARED_RT": {
      "description": "Provider exposes pre-atmosphere extraterrestrial or volume-emission source terms with documented geometry; the project's shared atmosphere performs the required attenuation/scattering.",
      "requires": [
        "source_quantity_semantics",
        "source_reference_frame_or_emission_altitude_geometry",
        "spectral_or_channel_response",
        "shared_atmosphere_identity",
        "shared_rt_provenance"
      ],
      "alreadyAtmosphericallyAttenuatedInputAllowed": false
    },
    "FULL_FORWARD_MATCHED_ATMOSPHERE": {
      "description": "Provider itself returns observer-level directional radiance after attenuation/scattering through an atmosphere that is demonstrably the same frozen atmosphere state used by the total-sky calculation.",
      "requires": [
        "directional_observer_level_radiance",
        "complete_atmosphere_provenance",
        "atmosphere_identity",
        "proof_of_parameter_equivalence_or_exact_shared_runtime",
        "no_second_atmospheric_propagation"
      ],
      "mustBypassSecondAtmosphericPropagation": true
    },
    "REFERENCE_TEMPLATE_DIFFERENT_ATMOSPHERE": {
      "description": "Published/model radiance already contains atmospheric effects under a different, standard, or incompletely known atmosphere.",
      "eligibleForSameAtmosphereTotalSkyProvider": false,
      "eligibleForResearchTemplateOrUncertaintyPrior": true,
      "mayBeRelabeledWithCurrentAtmosphereIdentity": false
    }
  },
  "gambonsBoundary": {
    "publishedV1IncludesAtmosphericAttenuationAndScattering": true,
    "publishedV1OutputMayBeFedThroughSharedAtmosphereAgain": false,
    "publishedDefaultAtmosphereMayBeRelabeledAsCurrentMeasuredAtmosphere": false,
    "admissionAsFullForwardProviderRequiresExactAtmosphereEquivalence": true,
    "admissionAsSourceOnlyProviderRequiresDocumentedExtractionOfPreAtmosphereComponents": true,
    "constantAirglowRemainsSessionStateUncertainty": true
  },
  "palaceBoundary": {
    "airglowIsVolumeEmissionNotTopOfAtmospherePointSource": true,
    "emissionLayerGeometryMustBePreserved": true,
    "ifPalaceAtmosphericAbsorptionScatteringEnabled": "do not apply the shared atmosphere a second time",
    "ifPalaceAtmosphericAbsorptionScatteringDisabled": "do not treat emitted spectrum as observer-level radiance; any shared-RT adapter must explicitly model the emission-layer path through the atmosphere",
    "paranalAirglowMayBeRelabeledAsOtherSiteMeasuredAirglow": false
  },
  "zodiacalAndIntegratedStarlightBoundary": {
    "extraterrestrialSourceTermsMayUseSharedAtmosphericRT": true,
    "alreadyObserverLevelAtmosphereIncludedMapsMayUseSharedAtmosphericRTAgain": false,
    "diffuseGalacticAndExtragalacticTermsMustPreserveTheirPublishedQuantitySemantics": true
  },
  "providerProvenanceMinimum": [
    "totalSkyComponent",
    "atmosphereTreatmentMode",
    "atmosphereIdentity",
    "sourceQuantitySemantics",
    "atmosphericPropagationApplied",
    "atmosphericPropagationProvenance",
    "validatedSupport",
    "productionAuthorized"
  ],
  "compositorImplication": {
    "futureRuntimeMustRejectMissingAtmosphereTreatmentModeForNaturalNight": true,
    "futureRuntimeMustRejectReferenceTemplateDifferentAtmosphereAsValidatedSameAtmosphere": true,
    "futureRuntimeMustRejectDoubleAtmosphericPropagation": true,
    "currentTotalSkyCompositorAtmosphereIdentityCheckAloneDoesNotEstablishPhysicalEquivalence": true,
    "runtimeStrengtheningRequiredBeforeProviderPromotion": true
  },
  "validationGate": {
    "implementationMayBeResearchOnlyBeforeEmpiricalValidation": true,
    "moonlessDirectionalMeasurementsAcrossMultipleNightsRequired": true,
    "sessionAirglowOrExplicitLatentUncertaintyRequired": true,
    "noTaylorJerusalemResidualTuning": true,
    "validatedByThisProject": false,
    "productionAuthorized": false
  }
}
