{
  "schemaVersion": 1,
  "contractId": "night-background-source-admission-v1",
  "status": "REVIEW_ONLY_NO_PROVIDER_PROMOTION",
  "linearCompositionOnly": true,
  "magnitudeOrSqmSpaceAdditionForbidden": true,
  "naturalNight": {
    "preferredModelFamily": "GAMBONS",
    "requiredPhysicalComponents": [
      "integrated_starlight",
      "diffuse_galactic_light",
      "extragalactic_background_light",
      "zodiacal_light",
      "airglow"
    ],
    "requiredAtmosphericEffects": ["attenuation", "scattering_into_field_of_view"],
    "requiredOutputChannels": ["johnsonV", "photopic", "scotopic"],
    "requiredInputs": [
      "observer_location",
      "observer_elevation",
      "observation_time",
      "target_direction",
      "atmosphere_identity",
      "aerosol_state",
      "airglow_state_or_explicit_uncertainty"
    ],
    "moonlightMustBeExcluded": true,
    "artificialSkyglowMustBeExcluded": true,
    "constantDarkSkyFloorAllowed": false,
    "paranalSkyCalcMayBeUsedAsAirglowSpectralReference": true,
    "paranalSkyCalcMayBeSilentlyTreatedAsGlobalModel": false,
    "validatedByThisProject": false,
    "productionAuthorized": false
  },
  "artificialSkyglow": {
    "directionalTargetModelRequired": true,
    "constantSiteFloorAllowed": false,
    "naturalBackgroundSubtractionRequiredWhenCalibratingFromTotalSkyMeasurements": true,
    "moonlightSubtractionRequiredWhenCalibratingFromMoonlitMeasurements": true,
    "admissibleTiers": {
      "MEASURED_DIRECTIONAL_ALL_SKY": {
        "description": "calibrated all-sky radiance/photometry map with direction and time",
        "required": ["spectral_or_channel_response", "absolute_calibration", "timestamp", "direction_map", "uncertainty"]
      },
      "PHYSICAL_DIRECTIONAL_PROPAGATION": {
        "description": "artificial emission inventory propagated through the same atmospheric state",
        "required": ["emission_inventory", "upward_emission_function", "spectral_power_distribution", "atmosphere_identity", "directional_radiance", "validation"]
      },
      "ZENITH_ATLAS_ONLY": {
        "description": "World-Atlas/VIIRS-like zenith baseline",
        "eligibleForArbitraryTargetDirection": false,
        "eligibleForZenithOnlyResearch": true
      }
    },
    "validatedByThisProject": false,
    "productionAuthorized": false
  },
  "providerAdmission": {
    "sameAtmosphereIdentityRequired": true,
    "sameGeometryDirectionRequired": true,
    "validatedSupportRequiredBeforeDefaultTotalSky": true,
    "componentSpecificUncertaintyRequired": true,
    "jointCovarianceMayNotBeAssumedZeroWithoutEvidence": true,
    "failClosedOnMissingComponent": true
  },
  "references": [
    "Masana et al. 2021, A multi-band map of the natural night sky brightness including Gaia and Hipparcos integrated starlight (GAMBONS)",
    "Masana et al. 2024, enhanced GAMBONS",
    "ESO Cerro Paranal Advanced Sky Model / SkyCalc",
    "Falchi et al. 2016, New World Atlas of Artificial Night Sky Brightness"
  ]
}
