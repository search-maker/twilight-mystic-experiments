{
  "schemaVersion": 1,
  "contractId": "night-background-source-admission-v1",
  "status": "REVIEW_ONLY_NO_PROVIDER_PROMOTION",
  "linearCompositionOnly": true,
  "magnitudeOrSqmSpaceAdditionForbidden": true,
  "naturalNight": {
    "preferredModelFamily": "GAMBONS",
    "preferredModelRole": "STRUCTURAL_ASTROPHYSICAL_BASELINE_WITH_EXPLICIT_AIRGLOW_AND_ATMOSPHERE_STATE_OVERRIDE_OR_UNCERTAINTY",
    "requiredPhysicalComponents": [
      "integrated_starlight",
      "diffuse_galactic_light",
      "extragalactic_background_light",
      "zodiacal_light",
      "airglow"
    ],
    "requiredAtmosphericEffects": ["attenuation", "scattering_into_field_of_view"],
    "requiredOutputChannels": ["johnsonV", "photopic", "scotopic"],
    "spectralTotalSkyRule": {
      "bandOnlyProviderMayClaimSpectralChannel": false,
      "spectralChannelRequiresSeparatelyAdmittedSpectralComponentModelOrMeasurement": true,
      "paranalSkyCalcSpectrumMayBeUsedAsReferenceTemplateOnly": true,
      "paranalSpectrumMayBeSilentlyAppliedAsGlobalSiteState": false
    },
    "requiredInputs": [
      "observer_location",
      "observer_elevation",
      "observation_time",
      "target_direction",
      "atmosphere_identity",
      "aerosol_state",
      "airglow_state_or_explicit_uncertainty"
    ],
    "moonlightMustBeExcluded": true,
    "artificialSkyglowMustBeExcluded": true,
    "constantDarkSkyFloorAllowed": false,
    "sourceSemantics": {
      "gambons2021": {
        "citation": "Masana et al. 2021, MNRAS 501, 5443-5456, DOI 10.1093/mnras/staa4005",
        "modelScope": "cloudless moonless natural sky; Gaia/Hipparcos integrated starlight plus DGL/EBL, zodiacal light and airglow with atmospheric attenuation and scattering",
        "publishedChannels": ["johnsonV", "photopic", "scotopic"],
        "criticalAirglowBoundary": "The published v1 results assume constant airglow radiance regardless of location and time; the paper states final sky brightness is highly dependent on atmospheric conditions including airglow.",
        "constantAirglowMayBeTreatedAsMeasuredSessionState": false,
        "constantAirglowMayBeUsedWithoutExplicitUncertainty": false
      },
      "gambons2024Enhanced": {
        "citation": "Masana et al. 2024, An enhanced version of the Gaia map of the brightness of the natural sky, arXiv:2408.17371",
        "role": "preferred future GAMBONS family candidate when exact implementation/version/assets are frozen",
        "automaticPromotionFromPaperDescription": false
      },
      "esoSkyCalc": {
        "citation": "ESO SkyCalc / Cerro Paranal Advanced Sky Model",
        "siteScope": "Paranal-family site model/reference, not a global site-state measurement",
        "separableRadianceComponents": [
          "scattered_moonlight",
          "scattered_starlight",
          "zodiacal_light",
          "lower_atmosphere_molecular_emission",
          "upper_atmosphere_airglow_lines",
          "airglow_residual_continuum"
        ],
        "mayProvideSpectralReference": true,
        "mayBeSilentlyTreatedAsGlobalAirglowOrAtmosphere": false
      }
    },
    "airglowAdmission": {
      "sessionSpecificStatePreferred": true,
      "ifSessionSpecificStateUnavailable": "retain explicit uncertainty/latent-state range; do not collapse to a universal constant",
      "mayTuneFromTaylorOrJerusalemResiduals": false,
      "validationRequiresMoonlessDirectionalMeasurementsAcrossMultipleNights": true
    },
    "paranalSkyCalcMayBeUsedAsAirglowSpectralReference": true,
    "paranalSkyCalcMayBeSilentlyTreatedAsGlobalModel": false,
    "validatedByThisProject": false,
    "productionAuthorized": false
  },
  "artificialSkyglow": {
    "directionalTargetModelRequired": true,
    "constantSiteFloorAllowed": false,
    "naturalBackgroundSubtractionRequiredWhenCalibratingFromTotalSkyMeasurements": true,
    "moonlightSubtractionRequiredWhenCalibratingFromMoonlitMeasurements": true,
    "admissibleTiers": {
      "MEASURED_DIRECTIONAL_ALL_SKY": {
        "description": "calibrated all-sky radiance/photometry map with direction and time",
        "required": ["spectral_or_channel_response", "absolute_calibration", "timestamp", "direction_map", "uncertainty"]
      },
      "PHYSICAL_DIRECTIONAL_PROPAGATION": {
        "description": "artificial emission inventory propagated through the same atmospheric state",
        "required": ["emission_inventory", "upward_emission_function", "spectral_power_distribution", "atmosphere_identity", "directional_radiance", "validation"]
      },
      "ZENITH_ATLAS_ONLY": {
        "description": "World-Atlas/VIIRS-like zenith artificial-brightness baseline or prior",
        "eligibleForArbitraryTargetDirection": false,
        "eligibleForZenithOnlyResearch": true,
        "eligibleAsSameAtmosphereDynamicProvider": false,
        "mustPreserveAtlasAtmosphereAssumptions": true
      }
    },
    "worldAtlas2016Boundary": {
      "citation": "Falchi et al. 2016, The new world atlas of artificial night sky brightness, Science Advances 2:e1600377, DOI 10.1126/sciadv.1600377",
      "publishedQuantity": "zenith artificial night sky brightness",
      "band": "Johnson-Cousins V",
      "modelAtmosphere": "standard clear US62 atmosphere",
      "publishedAerosolClarity": "K=1; sea-level V-band vertical extinction 0.33 mag; horizontal visibility 26 km; optical depth tau=0.31",
      "sourceIntegrationRadiusKm": 195,
      "mountainScreeningIncluded": false,
      "mayBeReinterpretedAsMeasuredDirectionalAllSky": false,
      "mayReplaceSameAtmospherePropagation": false
    },
    "validation": {
      "requiresDirectionalAllSkyMeasurementsAtMoreThanOneArtificialBurdenLevel": true,
      "requiresLocalLightingStateOrEmissionContext": true,
      "requiresNaturalAndApplicableLunarSubtractionWithUncertainty": true,
      "mayTuneFromTaylorOrJerusalemResiduals": false
    },
    "validatedByThisProject": false,
    "productionAuthorized": false
  },
  "providerAdmission": {
    "sameAtmosphereIdentityRequired": true,
    "sameGeometryDirectionRequired": true,
    "validatedSupportRequiredBeforeDefaultTotalSky": true,
    "componentSpecificUncertaintyRequired": true,
    "jointCovarianceMayNotBeAssumedZeroWithoutEvidence": true,
    "failClosedOnMissingComponent": true,
    "spectralClaimsRequireSpectralEvidence": true,
    "computationalCapabilityIsNotEmpiricalValidation": true,
    "empiricalValidationIsNotProductionAuthorization": true
  },
  "validationOpeningPolicy": {
    "caseSelectionMustBeResidualBlind": true,
    "componentMeasurementsMustBeOpenedBeforeAnyTotalSkyJointClaim": true,
    "noPostHocBackgroundScalingToTaylorOrJerusalem": true,
    "jointTotalSkyValidationRequiresSeparatelyFrozenProtocol": true
  },
  "references": [
    "Masana et al. 2021, MNRAS 501, 5443-5456, DOI 10.1093/mnras/staa4005",
    "Masana et al. 2024, enhanced GAMBONS, arXiv:2408.17371",
    "ESO Cerro Paranal Advanced Sky Model / SkyCalc",
    "Falchi et al. 2016, Science Advances 2:e1600377, DOI 10.1126/sciadv.1600377"
  ]
}
