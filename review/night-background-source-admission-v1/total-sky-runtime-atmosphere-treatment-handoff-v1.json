{
  "schemaVersion": 1,
  "contractId": "total-sky-runtime-atmosphere-treatment-handoff-v1",
  "status": "PREREGISTERED_RUNTIME_HANDOFF_NO_PROVIDER_PROMOTION_NO_RESIDUALS_OPENED",
  "purpose": "Map source-admission atmosphere semantics into the observer-level provenance required by the total-sky compositor, so a component cannot be relabeled or atmospherically propagated twice.",
  "runtimeTarget": {
    "repository": "search-maker/starsvisibility",
    "module": "scientific-tools/visibility-v3/total-sky-compositor.mjs",
    "reviewBranch": "review/total-sky-atmosphere-treatment-guard-v1",
    "draftPr": 123,
    "runtimeGuardMergedToMain": false,
    "providerPromotionAuthorized": false
  },
  "finalCompositorInputRule": {
    "nonSolarComponentMustBeObserverLevelDirectionalRadiance": true,
    "sourceOnlyOrVolumeEmissionMayEnterCompositorDirectly": false,
    "atmosphereIdentityStringAloneIsSufficient": false,
    "atmosphereTreatmentRecordRequired": true,
    "additionalAtmosphericPropagationRequiredMustBeFalse": true,
    "componentMayBeModeledAtmosphericallyPropagatedMoreThanOnce": false,
    "residualBasedTreatmentSelectionForbidden": true
  },
  "sourceAdmissionToRuntimeMapping": {
    "SOURCE_ONLY_SHARED_RT": {
      "sourceStateMayEnterCompositorDirectly": false,
      "requiredIntermediateAction": "propagate the documented source or emission geometry through the frozen shared atmosphere before composition",
      "finalRuntimeAtmosphereTreatmentMode": "SHARED_ATMOSPHERE_PROPAGATED",
      "finalPropagationCount": 1,
      "finalPropagationAtmosphereIdentityMustEqualRequestedAtmosphere": true,
      "finalOutputLevel": "OBSERVER_LEVEL_RADIANCE"
    },
    "FULL_FORWARD_MATCHED_ATMOSPHERE": {
      "sourceStateMayEnterCompositorDirectly": true,
      "finalRuntimeAtmosphereTreatmentMode": "PROVIDER_INTERNAL_PROPAGATED",
      "finalPropagationCount": 1,
      "finalPropagationAtmosphereIdentityMustEqualRequestedAtmosphere": true,
      "proofOfExactAtmosphereEquivalenceStillRequired": true,
      "finalOutputLevel": "OBSERVER_LEVEL_RADIANCE"
    },
    "REFERENCE_TEMPLATE_DIFFERENT_ATMOSPHERE": {
      "sourceStateMayEnterValidatedSameAtmosphereCompositor": false,
      "mayBeUsedAsResearchTemplateOrUncertaintyPrior": true,
      "mayBeRelabeledToRequestedAtmosphere": false
    },
    "EMPIRICAL_OBSERVER_LEVEL_DIRECTIONAL": {
      "sourceStateMayEnterCompositorDirectly": true,
      "finalRuntimeAtmosphereTreatmentMode": "EMPIRICAL_OBSERVER_LEVEL",
      "finalPropagationCount": 0,
      "observationAtmosphereIdentityMustEqualRequestedAtmosphere": true,
      "finalOutputLevel": "OBSERVER_LEVEL_RADIANCE",
      "secondModeledPropagationForbidden": true
    }
  },
  "componentExamples": {
    "gambonsPublishedObserverLevel": {
      "sourceAdmissionMode": "REFERENCE_TEMPLATE_DIFFERENT_ATMOSPHERE unless exact published-atmosphere equivalence is independently proven",
      "maySimplyCopyRequestedAtmosphereIdentity": false,
      "mayPassThroughSharedAtmosphereAgain": false
    },
    "palaceVolumeEmissionWithoutInternalPropagation": {
      "sourceAdmissionMode": "SOURCE_ONLY_SHARED_RT",
      "mayEnterCompositorBeforeEmissionLayerTransport": false,
      "sharedRtMustPreserveEmissionLayerGeometry": true
    },
    "palaceObserverLevelWithInternalPropagation": {
      "sourceAdmissionMode": "FULL_FORWARD_MATCHED_ATMOSPHERE only if the PALACE propagation atmosphere is proven equivalent to the frozen requested atmosphere",
      "mayPassThroughSharedAtmosphereAgain": false
    },
    "measuredDirectionalNaturalOrArtificialRadiance": {
      "sourceAdmissionMode": "EMPIRICAL_OBSERVER_LEVEL_DIRECTIONAL",
      "requiresAbsoluteCalibrationAndDirectionalTimeProvenance": true,
      "requiresObservationAtmosphereIdentity": true,
      "secondModeledPropagationForbidden": true
    },
    "worldAtlas2016ZenithPrior": {
      "sourceAdmissionMode": "REFERENCE_TEMPLATE_DIFFERENT_ATMOSPHERE",
      "arbitraryTargetDirectionEligible": false,
      "sameAtmosphereDynamicProviderEligible": false
    }
  },
  "lunarComponentHandoff": {
    "roloExtraterrestrialSourceMayEnterCompositorDirectly": false,
    "mysticScatteredMoonlightAfterFrozenAtmospherePropagationWouldMapTo": "SHARED_ATMOSPHERE_PROPAGATED",
    "atmosphericScatteredMoonlightValidatedByThisProject": false,
    "physicalFiniteDiskProviderAuthorized": false
  },
  "claimBoundary": {
    "computationalGuardImplementedOnDraftBranch": true,
    "runtimeExactHeadCiRequiredBeforeMerge": true,
    "runtimeGuardMergeIsNotProviderValidation": true,
    "providerValidationIsNotProductionAuthorization": true,
    "jointTotalSkyValidationProtocolStillRequired": true,
    "TaylorJerusalemResidualTuningForbidden": true,
    "productionAuthorized": false
  }
}
